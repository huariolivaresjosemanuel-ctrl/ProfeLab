{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:profelab:workshop-content:2.1",
  "title": "Manifest ProfeLab Content V2.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "minimumAppSchema",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "contentContractVersion": {
      "enum": [
        "2.0",
        "2.1"
      ]
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}$"
    },
    "minimumAppSchema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "minimumAppVersion": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 180,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "required": [
        "id",
        "name",
        "unit",
        "materialKind",
        "contentOrigin",
        "distributionApproved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "synonyms": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "materialKind": {
          "enum": [
            "CONSUMABLE",
            "REUSABLE",
            "TOOL"
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "materialId",
              "name",
              "ratio",
              "unit",
              "reason",
              "source",
              "verified"
            ],
            "properties": {
              "materialId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              "ratio": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              }
            }
          }
        },
        "contentOrigin": {
          "enum": [
            "EDITORIAL_PROFELAB",
            "USER_AUTHORED"
          ]
        },
        "distributionApproved": {
          "const": true
        }
      }
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "name",
        "amount",
        "unit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "materialId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string"
        },
        "materialKind": {
          "enum": [
            "CONSUMABLE",
            "REUSABLE",
            "TOOL"
          ]
        },
        "contentAmount": {
          "type": [
            "number",
            "string"
          ]
        },
        "contentUnit": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "contentOrigin",
        "distributionApproved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "visualTemplate": {
          "enum": [
            "DIDACTIC",
            "CONSTRUCTION",
            "EXPERIMENT",
            "CREATIVE",
            "ACADEMIC"
          ]
        },
        "layoutId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "images": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "assetImages": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+\\.(png|jpg|jpeg|webp)$"
          }
        },
        "grades": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "materials": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              "title": {
                "type": "string",
                "maxLength": 4000
              },
              "images": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
                }
              }
            }
          }
        },
        "sectionOrder": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "enum": [
              "purpose",
              "inquiry",
              "materials",
              "preparation",
              "steps",
              "classroom",
              "variants",
              "safety",
              "sources",
              "evidence"
            ]
          }
        },
        "contentOrigin": {
          "enum": [
            "EDITORIAL_PROFELAB",
            "USER_AUTHORED"
          ]
        },
        "distributionApproved": {
          "const": true
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "id",
        "title",
        "template",
        "sectionOrder",
        "contentOrigin",
        "distributionApproved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "title": {
          "type": "string"
        },
        "template": {
          "enum": [
            "DIDACTIC",
            "CONSTRUCTION",
            "EXPERIMENT",
            "CREATIVE",
            "ACADEMIC"
          ]
        },
        "sectionOrder": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "purpose",
              "inquiry",
              "materials",
              "preparation",
              "steps",
              "classroom",
              "variants",
              "safety",
              "sources",
              "evidence"
            ]
          }
        },
        "contentOrigin": {
          "enum": [
            "EDITORIAL_PROFELAB",
            "USER_AUTHORED"
          ]
        },
        "distributionApproved": {
          "const": true
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "path",
        "type",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]+$"
        },
        "type": {
          "enum": [
            "project",
            "experiment",
            "material",
            "layout",
            "image"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "distributionApproved": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "id",
              "source",
              "license",
              "distributionApproved"
            ],
            "properties": {
              "distributionApproved": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "Authoring contract. Android additionally checks paths, bytes, image decode, all checksums, references, IDs, material conflicts and runtime safety. Legacy V2 rights/material string adapters remain supported by Android."
}
