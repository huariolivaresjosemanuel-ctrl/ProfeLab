  "rules": {
    "neverFabricateCounts": true,
    "noAiOrNetwork": true,
    "hideDuringImmersivePdf": true,
    "neverCoverSensitiveInput": true,
    "requireExistingHandlers": true,
    "respectReducedMotion": true
