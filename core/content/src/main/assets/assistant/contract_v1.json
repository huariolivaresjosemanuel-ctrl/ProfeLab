{
  "schemaVersion": 1,
  "appId": "pe.profelab.app",
  "language": "es-PE",
  "offlineOnly": true,
  "disclaimer": "Los textos son recursos editoriales y los botones solo se activan cuando tienen acciones reales.",
  "contexts": [
    "global",
    "home",
    "taller",
    "sessions",
    "notebook",
    "library"
  ],
  "messages": [
    {
      "id": "assistant.home.hello",
      "context": "home",
      "text": "¡Hola! Puedo ayudarte a organizar tu día.",
      "buttonLabel": "Ver mis tareas",
      "action": {
        "type": "open_existing_handler",
        "target": "tasks_today"
      },
      "condition": "user_request_or_relevant_nonintrusive_state",
      "requiresLiveData": false,
      "fallback": "hide_button_if_no_real_handler"
    },
    {
      "id": "assistant.home.workshop",
      "context": "home",
      "text": "¿Quieres revisar qué materiales tienes disponibles?",
      "buttonLabel": "Abrir Taller",
      "action": {
        "type": "open_route",
        "target": "taller"
      },
      "condition": "user_request_or_relevant_nonintrusive_state",
      "requiresLiveData": false,
      "fallback": "hide_button_if_no_real_handler"
    },
    {
      "id": "assistant.home.resume",
      "context": "home",
      "text": "Podemos continuar un proyecto o sesión que dejaste pendiente.",
      "buttonLabel": "Ver mis trabajos",
      "action": {
        "type": "open_existing_handler",
        "target": "recent_work"
      },
      "condition": "user_request_or_relevant_nonintrusive_state",
      "requiresLiveData": true,
      "fallback": "hide_button_if_no_real_handler"
